*.iws
.idea/

# Microsoft VS Code related
.vscode/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/vendor/
# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# pubspec.lock 是**入库**的，别忽略：这是个应用（publish_to: none），不是被人
# 当依赖引入的库。锁文件在这里记的是"这个应用是拿哪套依赖跑起来的"，
# 别人 clone 下来才能装出一样的依赖树 —— 库才该忽略它，让下游自己解。

# linyapsd 是独立仓库，由它自己跟踪
/linyapsd/

# ll-killer 打包链路
# 工具本体是可下载的二进制（github.com/System233/ll-killer-go/releases），不入库
/ll-killer
# build-aux/ 是 ll-killer init 生成的脚本，等同于工具的产物：
# 内容随工具版本而变，改它等于改工具。第一次打包前跑一次 ./ll-killer init
# （别名 ./ll-killer build-aux）即可，工具本体不在库里，脚本也就没理由在
/build-aux/
# 它的工作目录：构建输出、overlay 残留、缓存，以及自动生成的 entry.sh
/linglong/output/
/linglong/overlay/
/linglong/cache/
/linglong/entry.sh
# 打包时由 linglong.yaml 解析出来的依赖清单，同样是构建产物
/linglong/depends.yaml
# ll-builder 解包 sources 的位置。远程构建下载下来的产物落这儿；
# 本地构建由 make-prebuilt.sh 把同一份放进来（见 linglong.yaml 的注释）。
# 里面的东西都是产物，不入库
/linglong/sources/
# packaging/make-prebuilt.sh 打出来的预构建包（传 Release 用的那份）：
# 11 MB 的二进制，同样不入库（谁 clone 下来自己跑一次那个脚本就有）
/dist/

# 打包产物
/*.layer
/*.uab
